{
  "manifest_version": 3,
  "name": "Private Redaction",
  "version": "1.0.0",
  "description": "Redact sensitive info from images, screenshots and text, privately in your browser, with a verifiable private-AI assist.",
  "homepage_url": "https://privateredact.app",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["https://privateredact.app/*", "https://api.nilai.nillion.network/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Private Redaction: capture and redact a region of this page",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
